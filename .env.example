# Copy to .env and fill in. NEVER commit .env. All values are placeholders.
LOG_LEVEL=INFO

# Discord (Developer Portal -> your application)
DISCORD_BOT_TOKEN=replace-me
DISCORD_CLIENT_ID=replace-me          # used only to print the invite URL

# Reddit (https://www.reddit.com/prefs/apps -> "script" or "web app"; requires API access)
REDDIT_CLIENT_ID=replace-me
REDDIT_CLIENT_SECRET=replace-me
REDDIT_USER_AGENT=RedditBridge/0.1 (by u/your_reddit_username)

# Database: SQLite by default (zero setup). For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://redditbridge:change-me@localhost:5432/redditbridge
# DATABASE_URL=sqlite+aiosqlite:///./redditbridge.db

# Free-plan limit per server
MAX_SUBREDDITS_PER_GUILD=5
